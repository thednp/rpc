{
  "name": "@thednp/rpc",
  "version": "0.3.0",
  "author": "thednp",
  "description": "⚡ A Vite plugin for creating server functions with automatic Remote Procedure Calls (RPC)",
  "keywords": [
    "rpc",
    "vite",
    "vite-plugin",
    "express",
    "fastify",
    "hono",
    "koa",
    "h3"
  ],
  "minimumDependencyAge": 0,
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./express": "./src/express/index.ts",
    "./fastify": "./src/fastify/index.ts",
    "./fastify/plugin": "./src/fastify/plugin.ts",
    "./helpers": "./src/client-helpers.ts",
    "./hono": "./src/hono/index.ts",
    "./koa": "./src/koa/index.ts",
    "./server": "./src/server.ts",
    "./h3": "./src/h3/index.ts"
  },
  "imports": {
    "@thednp/rpc": "./src/index.ts",
    "@thednp/rpc/server": "./src/server.ts",
    "@thednp/rpc/express": "./src/express/index.ts",
    "@thednp/rpc/fastify": "./src/fastify/index.ts",
    "@thednp/rpc/fastify/plugin": "./src/fastify/plugin.ts",
    "@thednp/rpc/hono": "./src/hono/index.ts",
    "@thednp/rpc/koa": "./src/koa/index.ts",
    "@thednp/rpc/helpers": "./src/client-helpers.ts",
    "@thednp/rpc/h3": "./src/h3/index.ts"
  },
  "publish": {
    "include": [
      "deno.json",
      "AGENTS.md",
      "CLAUDE.md",
      "src",
      "README.md",
      "LICENSE"
    ]
  },
  "tasks": {
    "test": "vitest run --coverage",
    "test:watch": "vitest --watch --coverage",
    "test:ui": "vitest --ui",
    "test:dev": "deno -A scripts/dev-test.js",
    "test:prod": "deno -A scripts/dev-test.js --mode=preview",
    "format": "deno fmt src tests examples/**/src",
    "lint": "deno task lint:ts && deno task check:ts",
    "lint:ts": "deno lint src",
    "fix:ts": "deno lint src --fix",
    "check:ts": "tsc -noEmit",
    "up:deno": "deno update --latest && deno -A scripts/update-deno.js"
  }
}
