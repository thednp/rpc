{
  "name": "@thednp/rpc",
  "version": "0.0.7",
  "license": "MIT",
  "author": "thednp",
  "description": "⚡ A Vite plugin for creating server functions with automatic Remote Procedure Calls (RPC)",
  "homepage": "https://github.com/thednp/rpc#readme",
  "keywords": [
    "rpc",
    "vite",
    "vite-plugin",
    "express",
    "fastify",
    "hono",
    "koa"
  ],
  "bugs": {
    "url": "https://github.com/thednp/rpc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thednp/rpc.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./express": "./dist/express/express.mjs",
    "./fastify": "./dist/fastify/fastify.mjs",
    "./fastify/plugin": "./dist/fastify/plugin/fastify/plugin.mjs",
    "./helpers": "./dist/helpers/helpers.mjs",
    "./hono": "./dist/hono/hono.mjs",
    "./koa": "./dist/koa/koa.mjs",
    "./server": "./dist/server/server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "test-ui": "vitest --ui",
    "test-dev": "node scripts/dev-test",
    "test-prod": "node scripts/dev-test --mode=preview",
    "format": "deno fmt src tests examples/**/src",
    "clean": "rm -rf examples/**/dist examples/**/node_modules examples/**/package-lock.json examples/**/pnpm-lock.yaml examples/**/bun.lockb examples/**/deno.lock",
    "dev": "cd examples/spa && pnpm up && pnpm dev",
    "dev:koa": "cd examples/koa && pnpm up && pnpm dev",
    "dev:express": "cd examples/express && pnpm up && pnpm dev",
    "dev:fastify": "cd examples/fastify && pnpm up && pnpm dev",
    "dev:hono": "cd examples/hono && pnpm up && pnpm dev",
    "dev:ssr": "cd examples/ssr && pnpm up && pnpm dev",
    "lint": "pnpm lint:ts && pnpm check:ts",
    "lint:ts": "deno lint src",
    "fix:ts": "deno lint src --fix",
    "check:ts": "tsc -noEmit",
    "up:examples": "pnpm up -r --latest --filter \"./examples/*\" && pnpm ci -r --filter \"./examples/*\"",
    "up:root": "pnpm up --latest",
    "up:deno": "deno update && deno -A scripts/update-deno.js",
    "upd": "pnpm up:examples && pnpm up:root",
    "audit:src": "node scripts/audit-src.js",
    "prepublishOnly": "pnpm upd && pnpm up:deno && pnpm lint && pnpm format && pnpm audit:src && pnpm build",
    "build": "tsdown"
  },
  "dependencies": {
    "express": "^5.2.1",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "hono": "^4.12.33",
    "koa": "^3.2.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite-plugin-strip-comments": "^0.0.10",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
