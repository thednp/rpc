{
  "name": "ssr-rpc-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --outDir dist/client --mode=production",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server --mode=production",
    "preview": "pnpm build && pnpm start",
    "start": "NODE_ENV=production node --experimental-strip-types server.ts"
  },
  "dependencies": {
    "@thednp/rpc": "^0.0.1",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "~7.0.2",
    "valibot": "^1.4.2"
  },
  "packageManager": "pnpm@11.17.0"
}
