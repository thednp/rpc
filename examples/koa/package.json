{
  "name": "koa-rpc-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --outDir dist/client --mode=production",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server --mode=production",
    "preview": "pnpm build && pnpm start",
    "start": "NODE_ENV=production node server"
  },
  "dependencies": {
    "@thednp/rpc": "^0.0.1",
    "compression": "^1.8.1",
    "koa": "^3.2.1",
    "koa-body": "^8.0.0",
    "koa-connect": "^2.1.1",
    "koa-mount": "^4.2.0",
    "koa-static": "^5.0.0",
    "sirv": "^3.0.2",
    "valibot": "^1.4.2",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@types/koa": "^3.0.3",
    "@types/node": "^26.1.2",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@11.17.0"
}
