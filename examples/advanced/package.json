{
  "name": "advanced-rpc-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server",
    "lint": "deno lint src && tsc -noEmit",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --outDir dist/client --mode=production",
    "build:server": "vite build --ssr src/entry-server.ts --outDir dist/server --mode=production",
    "preview": "pnpm build && pnpm start",
    "start": "NODE_ENV=production node server",
    "verify": "node --experimental-strip-types verify.mjs"
  },
  "dependencies": {
    "@thednp/rpc": "^0.4.0",
    "arktype": "^2.2.6",
    "compression": "^1.8.2",
    "effect": "^4.0.0",
    "express": "^5.2.1",
    "sirv": "^3.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "typescript": "~7.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
