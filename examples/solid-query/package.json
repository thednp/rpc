{
  "name": "solid-query-rpc-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build --outDir dist/client --mode=production",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server --mode=production",
    "preview": "pnpm build && pnpm start",
    "start": "NODE_ENV=production node server"
  },
  "dependencies": {
    "@tanstack/solid-query": "^5.104.0",
    "@thednp/rpc": "^0.3.7",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "sirv": "^3.0.2",
    "solid-js": "^1.9.15",
    "valibot": "^1.5.0",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "typescript": "~7.0.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "packageManager": "pnpm@11.22.0"
}
